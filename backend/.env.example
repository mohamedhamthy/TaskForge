# HTTP port; Railway provides PORT automatically in production.
PORT=5000

# MongoDB connection string for the TaskForge database.
MONGODB_URI=mongodb://127.0.0.1:27017/taskforge

# Random secret used to sign and verify JWTs; use 32+ characters in production.
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters

# Exact allowed frontend origin(s), comma-separated when using multiple domains.
CLIENT_ORIGIN=http://localhost:5173

# Runtime mode; use production on Railway.
NODE_ENV=development